---
/** Compact project list (name, scenario, experience) with the projects note and a link to the full page. */
import { getUi, type Lang } from '../lib/content';
interface Props { lang: Lang; rows: string[][]; note: string }
const { lang, rows, note } = Astro.props;
const ui = getUi(lang);
---
<div class="pl">
  <ul class="pl-list">
    {rows.map((r) => (
      <li class="pl-row reveal">
        <span class="pl-name">{r[0]}</span>
        <span class="pl-sc">{r[1]}</span>
        {r[2] && <span class="pl-ex">{r[2]}</span>}
      </li>
    ))}
  </ul>
  <p class="note">{note}</p>
  <a href={`/${lang}/projects/`} class="ul more">{ui.cta.projects}<i>→</i></a>
</div>

<style>
  .pl-list { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
  .pl-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.5fr); gap: 8px clamp(16px, 3vw, 48px); padding: 18px 0; border-top: 1px solid var(--line); align-items: baseline; }
  .pl-name { font-family: var(--display); font-weight: 700; font-size: clamp(18px, 1.6vw, 22px); }
  :lang(zh) .pl-name { font-weight: 600; }
  .pl-sc, .pl-ex { font-size: 15px; color: var(--muted); }
  .pl .note { margin-top: 20px; }
  .pl .more { margin-top: clamp(28px, 3vw, 40px); }
  @media (max-width: 760px) { .pl-row { grid-template-columns: 1fr; } }
</style>
