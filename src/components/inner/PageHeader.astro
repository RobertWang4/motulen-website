---
/**
 * Inner page header: white type block (tag, h1, lede), then an optional edge-to-edge photo band.
 * Without a band the next white section follows directly, so the bottom padding shrinks.
 */
interface Props {
  tag?: string;
  tagHref?: string;
  title: string;
  lede?: string;
  image?: string;
  alt?: string;
}
const { tag, tagHref, title, lede, image, alt = '' } = Astro.props;
---
<header class="ph">
  <div class:list={['ph-in wrap', !image && 'ph-solo']}>
    {tag && <p class="tag reveal">{tagHref ? <a href={tagHref}>{tag}</a> : tag}</p>}
    <h1 class="ph-title reveal">{title}</h1>
    {lede && <p class="lede ph-lede reveal">{lede}</p>}
  </div>
</header>
{image && <div class="ph-band"><img src={image} alt={alt} /></div>}

<style>
  .ph-in { padding-block: clamp(56px, 9vw, 140px) clamp(48px, 7vw, 104px); }
  .tag a { border-bottom: 1px solid currentColor; padding-bottom: 2px; transition: color 0.2s; }
  .tag a:hover { color: var(--teal); }
  .ph-title {
    margin: 0; max-width: 18ch; font-family: var(--display);
    font-size: clamp(40px, 6vw, 88px); font-weight: 700;
    letter-spacing: -0.025em; line-height: 1.04; text-wrap: balance;
  }
  :global(:lang(zh)) .ph-title { font-family: var(--display-zh); font-weight: 700; letter-spacing: 0.01em; line-height: 1.2; }
  .ph-solo { padding-bottom: clamp(8px, 2vw, 32px); }
  .ph-lede { margin: 28px 0 0; }
  .ph-band { height: clamp(280px, 42vw, 600px); overflow: hidden; background: var(--surface); }
  .ph-band img { width: 100%; height: 100%; object-fit: cover; }

</style>
