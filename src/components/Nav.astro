---
import { site, getUi, otherLang, type Lang } from '../lib/content';
interface Props { lang: Lang; altHref: string }
const { lang, altHref } = Astro.props;
const ui = getUi(lang);
// strip the GitHub Pages base path so /motulen-website/zh/about/ matches /zh/about/
const current = '/' + Astro.url.pathname.slice(import.meta.env.BASE_URL.length).replace(/^\//, '');
const all = (['home', 'about', 'services', 'approach', 'projects', 'contact'] as const).map((id) => ({
  id, label: ui.nav[id], href: id === 'home' ? `/${lang}/` : `/${lang}/${id}/`,
}));
const links = all.filter((n) => n.id !== 'home' && n.id !== 'contact');
const other = otherLang(lang);
---
<header id="site-nav" class="site-nav">
  <div class="nav-in">
    <a href={`/${lang}/`} class="brand">{site.brand.name}</a>

    <nav class="navlinks">
      {links.map((n) => (
        <a href={n.href} class:list={['navlink', current.startsWith(n.href) && 'current']} aria-current={current.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
      <a href={altHref} class="lang" hreflang={other === 'zh' ? 'zh-CN' : 'pl'} lang={other === 'zh' ? 'zh-CN' : 'pl'}>{ui.langName[other]}</a>
      <a href={`/${lang}/contact/`} class="navcta">{ui.nav.contact}</a>
    </nav>

    <button id="nav-toggle" class="navtoggle" aria-label={ui.menu} aria-expanded="false">
      <span></span><span></span>
    </button>
  </div>

  <nav id="nav-mobile" class="navmobile" hidden>
    {all.map((n) => <a href={n.href}>{n.label}</a>)}
    <a href={altHref} class="lang">{ui.langName[lang]} / {ui.langName[other]}</a>
  </nav>
</header>

<style>
  .site-nav {
    position: sticky; top: 0; z-index: 60;
    background: #fff; border-bottom: 1px solid var(--line);
  }
  .nav-in {
    margin: 0 auto; max-width: 1360px;
    display: flex; align-items: center; gap: 24px;
    height: var(--nav-h); padding-inline: var(--pad);
  }
  .brand {
    flex: none; font-family: var(--display); font-size: 17px; font-weight: 700;
    letter-spacing: 0.04em; color: var(--ink); white-space: nowrap;
  }

  .navlinks { margin-left: auto; display: flex; align-items: center; gap: clamp(16px, 2vw, 34px); }
  .navlink { font-size: 15px; font-weight: 500; color: var(--ink); position: relative; white-space: nowrap; }
  .navlink::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -5px; height: 1px;
    background: var(--blue); transform: scaleX(0); transform-origin: left;
    transition: transform 200ms ease-out;
  }
  .navlink:hover { color: var(--blue); }
  .navlink:hover::after, .navlink.current::after { transform: scaleX(1); }
  .navlink.current { color: var(--blue); }
  .lang { font-size: 14px; font-weight: 500; color: var(--muted); white-space: nowrap; }
  .lang:hover { color: var(--blue); }
  .navcta {
    border: 1px solid var(--ink); border-radius: var(--r-md);
    padding: 10px 20px; font-size: 14px; font-weight: 600;
    transition: color 0.2s, border-color 0.2s;
  }
  .navcta:hover { border-color: var(--blue); color: var(--blue); }

  .navtoggle {
    display: none; margin-left: auto; background: none; border: 0; cursor: pointer;
    width: 30px; height: 24px; flex-direction: column; justify-content: center; gap: 6px; padding: 0;
  }
  .navtoggle span { display: block; height: 1.5px; width: 22px; background: var(--ink); transition: transform 200ms ease-out; }
  .navtoggle[aria-expanded='true'] span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .navtoggle[aria-expanded='true'] span:last-child { transform: translateY(-3.75px) rotate(-45deg); }

  .navmobile {
    display: none; flex-direction: column;
    background: #fff; border-top: 1px solid var(--line);
    padding: 4px var(--pad) 18px;
  }
  .navmobile a {
    font-size: 17px; font-weight: 500; padding: 13px 0; border-bottom: 1px solid var(--line);
  }
  .navmobile a:last-child {
    border-bottom: 0; color: var(--muted);
    font-size: 15px;
  }

  @media (max-width: 900px) {
    .navlinks { display: none; }
    .navtoggle { display: flex; }
    .navmobile:not([hidden]) { display: flex; }
  }
</style>

<script>
  const m = document.getElementById('nav-mobile') as HTMLElement;
  const btn = document.getElementById('nav-toggle')!;
  btn.addEventListener('click', () => {
    m.hidden = !m.hidden;
    btn.setAttribute('aria-expanded', String(!m.hidden));
  });
</script>
