---
/**
 * The deck's three-step growth story: existing base, priority expansion, planned services.
 * The top rule changes from solid ink to blue to dashed so the step from "now" to "planned" is visible.
 */
interface Props { tiers: { title: string; items: string[] }[]; note: string }
const { tiers, note } = Astro.props;
---
<div class="tr">
  <ol class="tr-row">
    {tiers.map((t, i) => (
      <li class:list={['tr-item reveal', `tr-${i}`]}>
        <span class="tr-num">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="h3 tr-title">{t.title}</h3>
        <ul>{t.items.map((it) => <li>{it}</li>)}</ul>
      </li>
    ))}
  </ol>
  <p class="note">{note}</p>
</div>

<style>
  .tr-row { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(24px, 3vw, 48px); }
  .tr-item { padding-top: 22px; border-top: 2px solid var(--ink); min-width: 0; }
  .tr-1 { border-top-color: var(--blue); }
  .tr-2 { border-top: 2px dashed var(--faint); }
  .tr-num { font-family: var(--mono); font-size: 12px; letter-spacing: 0.12em; color: var(--muted); }
  .tr-1 .tr-num { color: var(--blue); }
  .tr-title { margin: 12px 0 0; }
  .tr-item ul { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 17px; }
  .tr-2 ul { color: var(--muted); }
  .tr .note { margin-top: clamp(28px, 3vw, 40px); }
  @media (max-width: 800px) { .tr-row { grid-template-columns: 1fr; gap: 36px; } }
</style>
