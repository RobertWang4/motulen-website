---
/** The closing band: night photo under a navy overlay. */
interface Props { headline: string; sub?: string; cta: string; href: string; photo?: string; alt?: string }
const { headline, sub, cta, href, photo, alt = '' } = Astro.props;
---
<section class="cb">
  {photo && <img class="cb-photo" src={photo} alt={alt} loading="lazy" />}
  <div class="wrap cb-in reveal">
    <div>
      <h2 class="h2 cb-title">{headline}</h2>
      {sub && <p class="cb-sub">{sub}</p>}
    </div>
    <a href={href} class="btn btn-p">{cta}<i>→</i></a>
  </div>
</section>

<style>
  .cb { position: relative; overflow: hidden; background: var(--navy); color: #fff; padding-block: clamp(80px, 11vw, 160px); border-bottom: 1px solid rgba(255, 255, 255, 0.12); }
  .cb-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cb::after { content: ''; position: absolute; inset: 0; background: rgba(4, 23, 52, 0.82); }
  .cb-in { position: relative; z-index: 1; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 36px; }
  .cb-title { max-width: 20ch; color: #fff; text-wrap: balance; }
  :global(:lang(zh)) .cb-title { max-width: 9.4em; }
  .cb-sub { margin: 22px 0 0; color: rgba(255, 255, 255, 0.66); font-size: clamp(16px, 1.3vw, 19px); }
</style>
