---
/** The single navy closing band (DESIGN.md: navy only here and in the footer). */
interface Props { headline: string; sub?: string; cta: string; href: string }
const { headline, sub, cta, href } = Astro.props;
---
<section class="cb">
  <div class="wrap cb-in reveal">
    <div>
      <h2 class="h2 cb-title">{headline}</h2>
      {sub && <p class="cb-sub">{sub}</p>}
    </div>
    <a href={href} class="btn btn-p">{cta}<i>→</i></a>
  </div>
</section>

<style>
  .cb { background: var(--navy); color: #fff; padding-block: clamp(80px, 11vw, 160px); border-bottom: 1px solid rgba(255, 255, 255, 0.12); }
  .cb-in { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 36px; }
  .cb-title { max-width: 20ch; color: #fff; text-wrap: balance; }
  :global(:lang(zh)) .cb-title { max-width: 9.4em; }
  .cb-sub { margin: 22px 0 0; color: rgba(255, 255, 255, 0.66); font-size: clamp(16px, 1.3vw, 19px); }
</style>
