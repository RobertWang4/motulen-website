---
import { site, getNav, otherLang, type Lang } from '../lib/content';
interface Props { lang: Lang; altHref: string }
const { lang, altHref } = Astro.props;
const { ui, about, groups } = getNav(lang);
const links = [
  { label: ui.nav.home, href: `/${lang}/` },
  { label: ui.nav.platform, href: `/${lang}/platform/` },
  { label: ui.nav.contact, href: `/${lang}/contact/` },
];
---
<footer class="site-footer">
  <div class="fgrid">
    <div class="fbrand">
      <a href={`/${lang}/`} class="fmark"><img src="/img/brand/logo-white.png" alt={site.brand.name} width="1000" height="246" /></a>
      <p>{ui.footer.tagline}</p>
    </div>
    <div>
      <h2>{ui.nav.about}</h2>
      <ul>{about.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>
    </div>
    <div>
      <h2>{ui.nav.services}</h2>
      <ul>{groups.flatMap((g) => g.items).map((s) => <li><a href={s.href}>{s.title}</a></li>)}</ul>
    </div>
    <div>
      <h2>{ui.footer.navTitle}</h2>
      <ul>{links.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </div>
    <div>
      <h2>{ui.footer.contactTitle}</h2>
      <ul>
        <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
        <li><a href={`tel:${site.contact.phone.replace(/\s/g, '')}`}>{site.contact.phone}</a></li>
        <li>{site.contact.address[lang]}</li>
        <li><a href={altHref} data-alt>{ui.langName[lang]} / {ui.langName[otherLang(lang)]}</a></li>
      </ul>
    </div>
  </div>
  <div class="fbot">
    <span>© {new Date().getFullYear()} {site.brand.name}</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy); color: rgba(255, 255, 255, 0.7);
    padding: clamp(56px, 8vw, 96px) var(--pad) 30px;
  }
  .fgrid {
    margin: 0 auto; max-width: 1360px;
    display: grid; grid-template-columns: 1.4fr 1fr 1.3fr 1fr 1.3fr; gap: clamp(28px, 5vw, 72px); align-items: start;
  }
  .fmark { display: inline-block; }
  .fmark img { display: block; height: 36px; width: auto; }
  .fbrand p { font-size: 15px; line-height: 1.7; max-width: 30ch; margin-top: 20px; }
  .fgrid h2 {
    font-family: var(--mono); font-size: 12px; font-weight: 400;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5); margin: 0 0 18px;
  }
  .fgrid ul { list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 15px; margin: 0; padding: 0; }
  .fgrid a { transition: color 0.2s; }
  .fgrid a:hover { color: #fff; }
  .fbot {
    margin: clamp(46px, 7vw, 80px) auto 0; max-width: 1360px;
    padding-top: 22px; border-top: 1px solid rgba(255, 255, 255, 0.16);
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.06em; color: rgba(255, 255, 255, 0.5);
  }
  @media (max-width: 800px) {
    .fgrid { grid-template-columns: 1fr 1fr; }
    .fbrand { grid-column: 1 / -1; }
  }
</style>
