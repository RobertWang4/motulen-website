---
/** Five markets set as large type in one row; Poland marked as base. No map (spec §7.2). */
import { getUi, type Lang, type Market } from '../lib/content';
interface Props { lang: Lang; markets: Market[]; note: string }
const { lang, markets, note } = Astro.props;
const ui = getUi(lang);
---
<div class="mk">
  <ul class="mk-row">
    {markets.map((m) => (
      <li class:list={['mk-item reveal', m.role === 'base' && 'mk-base']}>
        <span class="mk-role">{ui.roles[m.role]}</span>
        <span class="mk-name">{m.name}</span>
        {lang === 'zh' && m.local !== m.name && <span class="mk-local">{m.local}</span>}
      </li>
    ))}
  </ul>
  <p class="note">{note}</p>
</div>

<style>
  .mk-row { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(16px, 2vw, 32px); }
  .mk-item { border-top: 1px solid var(--line); padding-top: 18px; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .mk-base { border-top: 2px solid var(--teal); padding-top: 17px; }
  .mk-role { font-family: var(--mono); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .mk-base .mk-role { color: var(--teal); }
  .mk-name {
    font-family: var(--display); font-weight: 700; line-height: 1.05;
    font-size: clamp(22px, 2.6vw, 42px); letter-spacing: -0.02em; overflow-wrap: anywhere;
  }
  :global(:lang(zh)) .mk-name { font-weight: 600; letter-spacing: 0.02em; white-space: nowrap; }
  .mk-local { font-size: 14px; color: var(--muted); }
  @media (max-width: 760px) {
    .mk-row { grid-template-columns: 1fr 1fr; }
    .mk-base { grid-column: 1 / -1; }
  }
</style>
