---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/inner/PageHeader.astro';
import SectionHead from '../../components/SectionHead.astro';
import Stages from '../../components/Stages.astro';
import NextStep from '../../components/NextStep.astro';
import ClosingBand from '../../components/ClosingBand.astro';
import { LANGS, getApproach, getHome, getUi, type Lang } from '../../lib/content';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const a = getApproach(lang);
const ui = getUi(lang);
const closing = getHome(lang).closing;
---
<Base lang={lang} title={a.title} description={a.description}>
  <PageHeader tag={ui.tags.approach} title={a.title} lede={a.lede} image={a.photo} alt={a.alt} />

  <section class="sec">
    <div class="wrap">
      <SectionHead num="01" tag={ui.tags.approach} headline={a.cooperation.headline} />
      <Stages stages={a.cooperation.stages} outputLabel={ui.output} />
      <p class="note reveal stages-note">{a.cooperation.note}</p>
    </div>
  </section>

  <section class="sec sec-line">
    <div class="wrap">
      <SectionHead num="02" tag={ui.tags.management} headline={a.management.headline} />
      <p class="mg-lede reveal">{a.management.lede}</p>
      <Stages stages={a.management.stages} />
      <p class="note reveal stages-note">{a.management.note}</p>
    </div>
  </section>

  <section class="sec values">
    <div class="wrap">
      <SectionHead num="03" tag={ui.tags.values} headline={a.values.headline} />
      <ol class="vl">
        {a.values.items.map((v, i) => (
          <li class="vl-row reveal">
            <span class="vl-num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="vl-title">{v.title}</h3>
            {v.items.length > 0 && <ul>{v.items.map((it) => <li>{it}</li>)}</ul>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <NextStep href={`/${lang}/contact/`} label={ui.nextStep} title={ui.nav.contact} />
  <ClosingBand headline={closing.headline} sub={closing.sub} cta={ui.cta.contact} href={`/${lang}/contact/`} />
</Base>

<style>
  .stages-note { margin-top: clamp(40px, 5vw, 64px); }
  .sec-line { border-top: 1px solid var(--line); }
  .mg-lede { margin: -24px 0 clamp(40px, 5vw, 64px); color: var(--blue); font-weight: 600; font-size: clamp(17px, 1.4vw, 21px); }
  .values { background: var(--surface); }
  .vl { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
  .vl-row {
    display: grid; grid-template-columns: clamp(56px, 6vw, 96px) minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 16px clamp(16px, 3vw, 48px);
    padding: clamp(24px, 2.6vw, 36px) 0; border-top: 1px solid var(--line); align-items: baseline;
  }
  .vl-num { font-family: var(--mono); font-size: clamp(20px, 2vw, 28px); color: var(--faint); }
  .vl-title { margin: 0; font-family: var(--display); font-weight: 700; font-size: clamp(22px, 2.2vw, 32px); line-height: 1.2; }
  :global(:lang(zh)) .vl-title { font-weight: 600; }
  .vl-row ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; font-size: 17px; color: var(--muted); }
  @media (max-width: 760px) {
    .vl-row { grid-template-columns: 48px minmax(0, 1fr); }
    .vl-row ul { grid-column: 2; }
  }
</style>
