---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/inner/PageHeader.astro';
import SectionHead from '../../components/SectionHead.astro';
import DataTable from '../../components/DataTable.astro';
import NextStep from '../../components/NextStep.astro';
import ClosingBand from '../../components/ClosingBand.astro';
import { LANGS, getProjects, getHome, getUi, type Lang } from '../../lib/content';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const p = getProjects(lang);
const ui = getUi(lang);
const closing = getHome(lang).closing;
---
<Base lang={lang} title={p.title} description={p.description}>
  <PageHeader tag={ui.tags.projects} title={p.title} lede={p.lede} image={p.photo} alt={p.alt} />
  <section class="sec">
    <div class="wrap"><div style="max-width: 960px">
      <SectionHead num="01" tag={ui.tags.experience} headline={p.headline} />
      <DataTable columns={p.columns} rows={p.rows} note={p.note} />
    </div></div>
  </section>
  <NextStep href={`/${lang}/direction/`} label={ui.nextStep} title={ui.nav.direction} />

  <ClosingBand headline={closing.headline} sub={closing.sub} cta={ui.cta.contact} href={`/${lang}/contact/`} />
</Base>
