---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/inner/PageHeader.astro';
import { LANGS, getContact, getUi, site, type Lang } from '../../lib/content';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const c = getContact(lang);
const ui = getUi(lang);
const tel = site.contact.phone.replace(/\s/g, '');
---
<Base lang={lang} title={c.title} description={c.description}>
  <PageHeader tag={ui.tags.contact} title={c.title} lede={c.lede} />
  <section class="sec">
    <div class="wrap ct">
      <dl class="ct-list">
        <div class="reveal"><dt class="tag">{c.labels.email}</dt><dd><a href={`mailto:${site.contact.email}`} class="big">{site.contact.email}</a></dd></div>
        <div class="reveal"><dt class="tag">{c.labels.phone}</dt><dd><a href={`tel:${tel}`} class="big">{site.contact.phone}</a></dd></div>
        <div class="reveal"><dt class="tag">{c.labels.address}</dt><dd class="big">{site.contact.address[lang]}</dd></div>
      </dl>
      <div class="ct-photo reveal"><img src={c.photo} alt={c.alt} /></div>
    </div>
  </section>
</Base>

<style>
  .ct { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); gap: clamp(40px, 6vw, 96px); align-items: start; }
  .ct-list { margin: 0; display: flex; flex-direction: column; }
  .ct-list > div { padding: clamp(24px, 3vw, 36px) 0; border-top: 1px solid var(--line); }
  .ct-list > div:last-child { border-bottom: 1px solid var(--line); }
  .ct-list dt { margin-bottom: 12px; }
  .ct-list dd { margin: 0; }
  .big { font-family: var(--display); font-weight: 700; font-size: clamp(24px, 2.8vw, 40px); line-height: 1.2; letter-spacing: -0.015em; overflow-wrap: anywhere; transition: color 0.2s; }
  :global(:lang(zh)) .big { font-weight: 600; letter-spacing: 0; }
  a.big:hover { color: var(--blue); }
  .ct-photo { aspect-ratio: 4 / 5; overflow: hidden; border-radius: var(--r-sm); background: var(--surface); }
  .ct-photo img { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 860px) { .ct { grid-template-columns: 1fr; } .ct-photo { aspect-ratio: 3 / 2; } }
</style>
