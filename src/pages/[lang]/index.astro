---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import ServiceIndex from '../../components/ServiceIndex.astro';
import Markets from '../../components/Markets.astro';
import Lifecycle from '../../components/Lifecycle.astro';
import ProjectList from '../../components/ProjectList.astro';
import NextStep from '../../components/NextStep.astro';
import Stages from '../../components/Stages.astro';
import PhotoBand from '../../components/PhotoBand.astro';
import ClosingBand from '../../components/ClosingBand.astro';
import { LANGS, getHome, getUi, getApproach, getProjects, listServices, type Lang } from '../../lib/content';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const h = getHome(lang);
const ui = getUi(lang);
const projects = getProjects(lang);
const approach = getApproach(lang);
const services = listServices(lang);
---
<Base lang={lang} title={h.title} description={h.description}>
  <!-- who we are -->
  <section class="hero">
    <img src={h.hero.photo} alt={h.hero.alt} />
    <div class="hero-veil"></div>
    <div class="hero-in wrap">
      <h1 class="h1 hero-title">{h.hero.headline}</h1>
      <p class="hero-lede">{h.hero.sub}</p>
      <a href={`/${lang}/contact/`} class="btn btn-p">{ui.cta.contact}<i>→</i></a>
    </div>
  </section>

  <section class="facts">
    <div class="wrap facts-grid">
      {h.facts.map((f) => (
        <div class="fact">
          <p class="eyebrow">{f.k}</p>
          <p class="fact-v">{f.v}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- positioning statement -->
  <section class="sec">
    <div class="wrap">
      <p class="tag reveal"><b>01</b><span>/</span><span>{ui.tags.about}</span></p>
      <p class="statement reveal">{h.statement}</p>
      <a href={`/${lang}/about/`} class="ul reveal">{ui.cta.about}<i>→</i></a>
    </div>
  </section>

  <!-- one warehouse, end to end -->
  <section class="sec sec-line">
    <div class="wrap">
      <SectionHead num="02" tag={ui.tags.lifecycle} headline={h.lifecycle.headline} />
      <Lifecycle lang={lang} steps={h.lifecycle.steps} footer={h.lifecycle.footer} footerService={h.lifecycle.footerService} />
    </div>
  </section>

  <!-- what we do -->
  <section class="sec sec-line">
    <div class="wrap">
      <SectionHead num="03" tag={ui.tags.services} headline={h.services.headline} />
      <ServiceIndex lang={lang} services={services} />
    </div>
  </section>

  <PhotoBand photo={h.band.photo} alt={h.band.alt} text={h.band.text} />

  <!-- where -->
  <section class="sec">
    <div class="wrap">
      <SectionHead num="04" tag={ui.tags.markets} headline={h.markets.headline} />
      <Markets lang={lang} markets={h.markets.items} note={h.markets.note} />
    </div>
  </section>

  <!-- how we work -->
  <section class="sec sec-line">
    <div class="wrap">
      <SectionHead num="05" tag={ui.tags.approach} headline={h.approach.headline} />
      <Stages stages={approach.stages} />
      <a href={`/${lang}/approach/`} class="ul more reveal">{ui.cta.approach}<i>→</i></a>
    </div>
  </section>

  <!-- experience -->
  <section class="sec sec-line">
    <div class="wrap">
      <SectionHead num="06" tag={ui.tags.projects} headline={projects.headline} />
      <ProjectList lang={lang} rows={projects.rows} note={projects.note} />
    </div>
  </section>

  <!-- why us -->
  <section class="sec values">
    <div class="wrap">
      <SectionHead num="07" tag={ui.tags.values} headline={h.values.headline} />
      <ul class="vals">
        {approach.values.map((v) => (
          <li class="val reveal">
            <h3 class="val-title">{v.title}</h3>
            <ul class="val-list">{v.items.map((it) => <li>{it}</li>)}</ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <NextStep href={`/${lang}/about/`} label={ui.nextStep} title={ui.nav.about} />

  <ClosingBand headline={h.closing.headline} sub={h.closing.sub} cta={ui.cta.contact} href={`/${lang}/contact/`} />
</Base>

<style>
  .hero { position: relative; height: clamp(520px, 86vh, 900px); overflow: hidden; background: var(--surface); }
  .hero > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-veil {
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(14, 17, 22, 0.55) 0%, rgba(14, 17, 22, 0.45) 45%, rgba(14, 17, 22, 0) 85%),
      linear-gradient(0deg, rgba(14, 17, 22, 0.55) 0%, rgba(14, 17, 22, 0) 65%);
  }
  .hero-in {
    position: relative; z-index: 2; height: 100%;
    display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-start;
    padding-bottom: clamp(48px, 7vw, 104px); color: #fff;
  }
  .hero-title { max-width: 14ch; color: #fff; text-wrap: balance; font-size: clamp(42px, 6.4vw, 96px); }
  .hero-lede { margin: clamp(18px, 2vw, 28px) 0 0; max-width: 40ch; font-size: clamp(17px, 1.4vw, 20px); line-height: 1.6; color: rgba(255, 255, 255, 0.9); }
  .hero .btn { margin-top: clamp(28px, 3vw, 44px); }
  @media (max-width: 700px) {
    .hero-veil { background: linear-gradient(0deg, rgba(14, 17, 22, 0.75) 0%, rgba(14, 17, 22, 0.4) 55%, rgba(14, 17, 22, 0.1) 100%); }
  }

  .facts { border-bottom: 1px solid var(--line); }
  .facts-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .fact { padding: clamp(24px, 2.6vw, 34px) clamp(16px, 2vw, 32px); border-right: 1px solid var(--line); }
  .fact:first-child { padding-left: 0; }
  .fact:last-child { border-right: 0; }
  .fact .eyebrow { margin: 0; }
  .fact-v { margin: 8px 0 0; font-family: var(--display); font-weight: 700; font-size: clamp(16px, 1.5vw, 22px); line-height: 1.3; }
  :lang(zh) .fact-v { font-weight: 600; word-break: keep-all; }
  @media (max-width: 760px) {
    .facts-grid { grid-template-columns: 1fr 1fr; }
    .fact { padding-left: 0; }
    .fact:nth-child(even) { padding-left: 20px; border-right: 0; }
    .fact:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }

  .statement {
    margin: 0 0 clamp(32px, 4vw, 48px); max-width: 22ch;
    font-family: var(--display); font-weight: 700; font-size: clamp(32px, 5vw, 76px);
    line-height: 1.12; letter-spacing: -0.025em; text-wrap: balance;
  }
  :lang(pl) .statement { max-width: 26ch; font-size: clamp(30px, 4vw, 60px); }
  :lang(zh) .statement { max-width: 17em; font-weight: 600; letter-spacing: 0.01em; line-height: 1.3; }
  .sec-line { border-top: 1px solid var(--line); }
  .more { margin-top: clamp(40px, 5vw, 64px); }

  .values { background: var(--surface); }
  .vals { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(20px, 2.4vw, 36px); }
  .val { border-top: 1px solid var(--ink); padding-top: 20px; }
  .val-title { margin: 0; font-family: var(--display); font-weight: 700; font-size: 20px; line-height: 1.25; }
  :lang(zh) .val-title { font-weight: 600; }
  .val-list { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: 15px; color: var(--muted); }
  @media (max-width: 1000px) { .vals { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .vals { grid-template-columns: 1fr; } }
</style>
