---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import Markets from '../../components/Markets.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import ProjectList from '../../components/ProjectList.astro';
import ClosingBand from '../../components/ClosingBand.astro';
import { LANGS, getHome, getUi, getProjects, getValue, getPlatform, groupedServices, type Lang } from '../../lib/content';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const h = getHome(lang);
const ui = getUi(lang);
const projects = getProjects(lang);
const value = getValue(lang);
const platform = getPlatform(lang);
const groups = groupedServices(lang);
---
<Base lang={lang} title={h.title} description={h.description}>
  <section class="hero">
    <video class="hero-video" autoplay muted loop playsinline preload="metadata" poster={h.hero.poster} aria-label={h.hero.alt}>
      <source src={h.hero.video} type="video/mp4" />
    </video>
    <div class="hero-veil"></div>
    <div class="hero-in wrap">
      <h1 class="h1 hero-title">{h.hero.headline.map((line) => <span>{line}</span>)}</h1>
      <p class="hero-lede">{h.hero.sub}</p>
      <p class="hero-small">{h.hero.small}</p>
      <a href={`/${lang}/contact/`} class="btn btn-p">{h.hero.cta}<i>→</i></a>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <SectionHead num="01" tag={ui.tags.services} headline={h.services.headline} />
      <ServiceCards lang={lang} groups={groups} />
    </div>
  </section>

  <section class="sec sec-line">
    <div class="wrap">
      <SectionHead num="02" tag={ui.tags.projects} headline={h.projects.headline} />
      <p class="intro reveal">{projects.intro}</p>
      <ProjectList lang={lang} cases={projects.cases} />
      <a href={`/${lang}/projects/`} class="ul more reveal">{ui.cta.allCases}<i>→</i></a>
    </div>
  </section>

  <section class="sec values">
    <div class="wrap">
      <SectionHead num="03" tag={ui.tags.value} headline={h.value.headline} />
      <ul class="vals">
        {value.values.items.map((v) => (
          <li class="val reveal">
            <h3 class="val-title">{v.title}</h3>
            {v.items.length > 0 && <p class="val-text">{v.items[0]}</p>}
          </li>
        ))}
      </ul>
      <a href={`/${lang}/value/`} class="ul more reveal">{ui.cta.more}<i>→</i></a>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <SectionHead num="04" tag={ui.tags.markets} headline={h.platform.headline} />
      <Markets lang={lang} markets={platform.markets.items} note={platform.markets.note} />
      <a href={`/${lang}/platform/`} class="ul more reveal">{ui.cta.more}<i>→</i></a>
    </div>
  </section>

  <ClosingBand headline={h.closing.headline} sub={h.closing.sub} cta={ui.cta.contact} href={`/${lang}/contact/`} photo={h.closing.photo} alt={h.closing.alt} />
</Base>

<script>
  // reduced motion / data saver: show the poster only, never download the video
  const v = document.querySelector<HTMLVideoElement>('.hero-video');
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  if (v && (matchMedia('(prefers-reduced-motion: reduce)').matches || saveData)) {
    v.pause();
    v.removeAttribute('autoplay');
    v.querySelectorAll('source').forEach((el) => el.remove());
    v.load();
  }
</script>

<style>
  .hero { position: relative; height: min(88vh, 860px); min-height: 560px; overflow: hidden; background: var(--navy); }
  .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 70% 50%; }
  .hero-veil {
    position: absolute; inset: 0;
    background: linear-gradient(90deg, rgba(4, 23, 52, 0.92) 0%, rgba(4, 23, 52, 0.78) 38%, rgba(4, 23, 52, 0) 72%);
  }
  .hero-in {
    position: relative; z-index: 2; height: 100%;
    display: flex; flex-direction: column; justify-content: center; align-items: flex-start;
    padding-top: clamp(24px, 6vh, 72px); color: #fff;
  }
  .hero-title { color: #fff; font-size: clamp(44px, 6vw, 96px); line-height: 1.08; letter-spacing: 0; }
  .hero-title span { display: block; }
  :global(:lang(zh)) .hero-title { font-weight: 800; }
  :global(:lang(zh)) .hero-title span { white-space: nowrap; }
  :global(:lang(pl)) .hero-title { font-size: clamp(34px, 3.7vw, 60px); max-width: 60vw; letter-spacing: -0.02em; }
  .hero-lede { margin: 28px 0 0; max-width: 46vw; font-size: clamp(19px, 1.8vw, 26px); font-weight: 600; line-height: 1.45; color: #fff; }
  .hero-small { margin: 12px 0 0; max-width: 36em; text-wrap: pretty; font-size: 16px; line-height: 1.7; color: rgba(255, 255, 255, 0.82); }
  :global(:lang(zh)) .hero-small { max-width: 44em; }
  .hero .btn { margin-top: 36px; padding: 16px 28px; font-size: 16px; }
  .hero .btn i { transition: transform 200ms ease-out; }
  .hero .btn:hover i { transform: translateX(4px); }
  @media (max-width: 800px) {
    .hero-veil { background: linear-gradient(0deg, rgba(4, 23, 52, 0.94) 0%, rgba(4, 23, 52, 0.82) 55%, rgba(4, 23, 52, 0.3) 100%); }
    .hero-in { justify-content: flex-end; padding: 0 var(--pad) 48px; }
    .hero-lede, :global(:lang(pl)) .hero-title { max-width: 100%; }
  }

  .sec-line { border-top: 1px solid var(--line); }
  .more { margin-top: clamp(40px, 5vw, 64px); }
  .intro { margin: -24px 0 clamp(32px, 4vw, 48px); max-width: 72ch; color: var(--muted); font-size: clamp(16px, 1.3vw, 19px); line-height: 1.75; }

  .values { background: var(--surface); }
  .vals { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(20px, 2.4vw, 36px); }
  .val { border-top: 1px solid var(--ink); padding-top: 20px; }
  .val-title { margin: 0; font-family: var(--display); font-weight: 700; font-size: 20px; line-height: 1.25; }
  :global(:lang(zh)) .val-title { font-family: var(--display-zh); font-weight: 700; }
  .val-text { margin: 12px 0 0; font-size: 15px; color: var(--muted); }
  @media (max-width: 1000px) { .vals { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .vals { grid-template-columns: 1fr; } }
</style>
