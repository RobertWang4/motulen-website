---
import Base from '../../../layouts/Base.astro';
import NextStep from '../../../components/NextStep.astro';
import ProjectList from '../../../components/ProjectList.astro';
import GroupGrid from '../../../components/GroupGrid.astro';
import ClosingBand from '../../../components/ClosingBand.astro';
import { LANGS, getHome, getProjects, getUi, groupedServices, listServices, type Lang } from '../../../lib/content';

export function getStaticPaths() {
  return LANGS.flatMap((lang) => listServices(lang).map((s) => ({ params: { lang, slug: s.id } })));
}
const lang = Astro.params.lang as Lang;
const groups = groupedServices(lang);
const s = listServices(lang).find((x) => x.id === Astro.params.slug)!;
const ui = getUi(lang);
const related = getProjects(lang).cases.filter((c) => c.services.includes(s.id));
const closing = getHome(lang).closing;
const [main, ...rest] = s.photos;
---
<Base lang={lang} title={s.title} description={s.subtitle}>
  <!-- Side list and content start at the top, so switching services never jumps:
       the list stays put (own view-transition name) and only the content crossfades. -->
  <section class="sv-sec">
    <div class="wrap sv">
      <nav class="sv-nav" aria-label={ui.nav.services}>
        {groups.map((g) => (
          <div class="sv-group">
            <p class="tag">{g.title}</p>
            <ol>
              {g.items.map((x) => (
                <li>
                  <a href={`/${lang}/services/${x.id}/`} class:list={[x.id === s.id && 'cur']} aria-current={x.id === s.id ? 'page' : undefined}>
                    <span>{x.number}</span>{x.title}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </nav>

      <article class="sv-body" data-swap="body">
        <p class="tag"><b>{s.number}</b><span>/</span><span>{ui.tags.service}</span></p>
        <h1 class="sv-title">{s.title}{s.plan && <span class="chip-plan">{ui.status.planned}</span>}</h1>
        <p class="sv-lede">{s.subtitle}</p>
        <figure class="sv-gallery">
          <img class="sv-main" src={main.src} alt={main.alt} />
          {rest.length > 0 && (
            <div class="sv-thumbs" style={`--n: ${Math.min(rest.length, 4)}`}>
              {rest.map((p) => <img src={p.src} alt={p.alt} loading="lazy" />)}
            </div>
          )}
          {s.caption && <figcaption class="sv-cap">{s.caption}</figcaption>}
        </figure>
        <GroupGrid groups={s.groups} />
        {s.link && <a href={s.link.href} class="ul sv-link" target="_blank" rel="noopener">{s.link.label}<i>↗</i></a>}
        {related.length > 0 && (
          <section class="sv-rel">
            <h2 class="sv-gtitle">{ui.relatedProjects}</h2>
            <ProjectList lang={lang} cases={related} />
          </section>
        )}
        <p class="note">{s.note}</p>
      </article>
    </div>
  </section>

  <!-- services switch in the side list, so the page ends by moving on to the next part of the story -->
  <NextStep href={`/${lang}/platform/`} label={ui.nextStep} title={ui.nav.platform} />

  <ClosingBand headline={closing.headline} sub={closing.sub} cta={ui.cta.contact} href={`/${lang}/contact/`} photo={closing.photo} alt={closing.alt} />
</Base>

<script>
  /**
   * Switch services in place: clicking the side list fetches the
   * target page and swaps only the content column, so the scroll
   * position and the side list stay where they are. Plain links still work without JS.
   */
  const swap = async (url: string, push: boolean) => {
    let doc: Document;
    try {
      const res = await fetch(url);
      if (!res.ok) throw new Error(String(res.status));
      doc = new DOMParser().parseFromString(await res.text(), 'text/html');
    } catch {
      location.href = url;
      return;
    }
    const apply = () => {
      for (const key of ['body']) {
        const cur = document.querySelector(`[data-swap="${key}"]`);
        const next = doc.querySelector(`[data-swap="${key}"]`);
        if (cur && next) {
          const node = document.importNode(next, true) as Element;
          // swapped-in content is already on screen: show it instead of waiting for the scroll reveal
          node.querySelectorAll('.reveal').forEach((el) => el.classList.add('in'));
          cur.replaceWith(node);
        }
      }
      document.querySelectorAll<HTMLAnchorElement>('.sv-nav ol a').forEach((a) => {
        const on = new URL(a.href).pathname === new URL(url, location.href).pathname;
        a.classList.toggle('cur', on);
        if (on) a.setAttribute('aria-current', 'page');
        else a.removeAttribute('aria-current');
      });
      // keep title, description, hreflang and the language switch pointing at the new service
      document.title = doc.title;
      const desc = doc.querySelector('meta[name="description"]')?.getAttribute('content') ?? '';
      document.querySelector('meta[name="description"]')?.setAttribute('content', desc);
      const pairs: [string, string][] = [['link[rel="alternate"]', 'href'], ['[data-alt]', 'href']];
      for (const [sel, attr] of pairs) {
        const olds = document.querySelectorAll(sel);
        const news = doc.querySelectorAll(sel);
        olds.forEach((el, i) => news[i] && el.setAttribute(attr, news[i].getAttribute(attr) ?? ''));
      }
      if (push) history.pushState({ svc: true }, '', url);
      // if the reader has scrolled past the top of the content, bring the new content's top into view
      const body = document.querySelector('[data-swap="body"]') as HTMLElement;
      const navH = (document.getElementById('site-nav') as HTMLElement).offsetHeight;
      const top = body.getBoundingClientRect().top;
      if (top < navH) window.scrollBy({ top: top - navH - 24, behavior: 'smooth' });
    };
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if ('startViewTransition' in document && !reduce) (document as any).startViewTransition(apply);
    else apply();
  };

  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('.sv-nav ol a');
    if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || (e as MouseEvent).button !== 0) return;
    if (a.getAttribute('aria-current') === 'page') { e.preventDefault(); return; }
    e.preventDefault();
    swap(a.href, true);
  });
  history.replaceState({ svc: true }, '');
  window.addEventListener('popstate', (e) => { if (e.state?.svc) swap(location.href, false); });
</script>

<style>
  .sv-sec { padding-block: clamp(40px, 6vw, 88px) clamp(72px, 10vw, 144px); }
  .sv { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: clamp(40px, 6vw, 112px); align-items: start; }
  .sv-nav { position: sticky; top: calc(var(--nav-h) + clamp(40px, 6vw, 88px)); view-transition-name: svc-nav; }
  .sv-body { view-transition-name: svc-body; min-width: 0; }
  .sv-title {
    margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; min-width: 0; overflow-wrap: anywhere;
    font-family: var(--display); font-weight: 700; font-size: clamp(36px, 4.8vw, 72px); line-height: 1.08; letter-spacing: -0.025em;
  }
  :global(:lang(zh)) .sv-title { font-family: var(--display-zh); font-weight: 700; letter-spacing: 0.01em; line-height: 1.2; }
  .sv-lede { margin: 20px 0 0; max-width: 46ch; color: var(--muted); font-size: clamp(17px, 1.4vw, 21px); line-height: 1.6; }
  .sv-gallery { margin: clamp(32px, 4vw, 48px) 0 clamp(40px, 5vw, 64px); }
  .sv-gallery img { width: 100%; object-fit: cover; border-radius: var(--r-sm); background: var(--surface); }
  .sv-main { aspect-ratio: 16 / 9; }
  .sv-thumbs { margin-top: 12px; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 12px; }
  .sv-thumbs img { aspect-ratio: 4 / 3; }
  .sv-cap { margin-top: 10px; font-size: 13px; color: var(--muted); }
  .sv-nav .sv-group + .sv-group { margin-top: 28px; }
  .sv-nav .tag { margin-bottom: 12px; }
  .sv-nav ol { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .sv-nav li a {
    display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line);
    font-size: 15px; font-weight: 500; color: var(--muted); transition: color 0.2s;
  }
  .sv-nav li a span { font-family: var(--mono); font-size: 12px; color: var(--faint); padding-top: 3px; }
  .sv-nav li a:hover, .sv-nav li a.cur { color: var(--teal); }
  .sv-nav li a.cur span { color: var(--teal); }

  .sv-gtitle { margin: 0; font-family: var(--display); font-weight: 700; font-size: clamp(22px, 2vw, 28px); line-height: 1.2; letter-spacing: -0.015em; }
  :global(:lang(zh)) .sv-gtitle { font-family: var(--display-zh); font-weight: 700; letter-spacing: 0; }
  .sv-body > .note { margin-top: clamp(40px, 5vw, 64px); padding-top: 20px; border-top: 1px solid var(--line); }

  .sv-link { margin-top: clamp(32px, 4vw, 48px); }
  .sv-rel { margin-top: clamp(40px, 5vw, 64px); }
  .sv-rel .sv-gtitle { margin-bottom: 20px; }

  @media (max-width: 900px) {
    .sv { grid-template-columns: 1fr; }
    .sv-nav { position: static; order: 2; }
  }
</style>
