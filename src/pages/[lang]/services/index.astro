---
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/inner/PageHeader.astro';
import SectionHead from '../../../components/SectionHead.astro';
import ServiceIndex from '../../../components/ServiceIndex.astro';
import ClosingBand from '../../../components/ClosingBand.astro';
import { LANGS, getServicesPage, getHome, getUi, listServices, type Lang } from '../../../lib/content';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const p = getServicesPage(lang);
const ui = getUi(lang);
const closing = getHome(lang).closing;
---
<Base lang={lang} title={p.title} description={p.description}>
  <PageHeader tag={ui.tags.services} title={p.title} lede={p.lede} image={p.photo} alt={p.alt} />
  <section class="sec">
    <div class="wrap">
      <SectionHead tag={ui.tags.services} headline={p.headline} />
      <ServiceIndex lang={lang} services={listServices(lang)} />
    </div>
  </section>
  <ClosingBand headline={closing.headline} sub={closing.sub} cta={ui.cta.contact} href={`/${lang}/contact/`} />
</Base>
