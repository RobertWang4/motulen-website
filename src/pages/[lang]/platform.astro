---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/inner/PageHeader.astro';
import SectionHead from '../../components/SectionHead.astro';
import Markets from '../../components/Markets.astro';
import DataTable from '../../components/DataTable.astro';
import GroupGrid from '../../components/GroupGrid.astro';
import NextStep from '../../components/NextStep.astro';
import ClosingBand from '../../components/ClosingBand.astro';
import { LANGS, getPlatform, getHome, getUi, type Lang } from '../../lib/content';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const p = getPlatform(lang);
const ui = getUi(lang);
const closing = getHome(lang).closing;
---
<Base lang={lang} title={p.title} description={p.description}>
  <PageHeader tag={ui.tags.platform} title={p.title} lede={p.lede} />

  <section class="sec">
    <div class="wrap">
      <SectionHead num="01" tag={ui.tags.markets} headline={p.markets.headline} />
      <p class="sub reveal">{p.markets.sub}</p>
      <Markets lang={lang} markets={p.markets.items} note={p.markets.note} />
    </div>
  </section>

  <section class="sec sec-line">
    <div class="wrap"><div class="narrow">
      <SectionHead num="02" tag={ui.tags.experience} headline={p.operating.headline} />
      <DataTable columns={p.operating.columns} rows={p.operating.rows} note={p.operating.note} />
    </div></div>
  </section>

  <section class="sec sec-line">
    <div class="wrap">
      <SectionHead num="03" tag={ui.tags.team} headline={p.team.headline} />
      <p class="sub reveal">{p.team.lede}</p>
      <figure class="team-photo reveal">
        <img src={p.team.photo} alt={p.team.alt} loading="lazy" />
        <figcaption class="note">{p.team.caption}</figcaption>
      </figure>
      <GroupGrid groups={p.team.groups} level={3} />
    </div>
  </section>

  <section class="sec sec-line">
    <div class="wrap">
      <SectionHead num="04" tag={ui.tags.talent} headline={p.talent.headline} badge={ui.status.planned} />
      <ul class="talent">{p.talent.items.map((it) => <li class="reveal">{it}</li>)}</ul>
      <a href={`/${lang}/services/recruitment/`} class="ul more reveal">{p.talent.linkLabel}<i>→</i></a>
    </div>
  </section>

  <NextStep href={`/${lang}/contact/`} label={ui.nextStep} title={ui.nav.contact} />
  <ClosingBand headline={closing.headline} sub={closing.sub} cta={ui.cta.contact} href={`/${lang}/contact/`} photo={closing.photo} alt={closing.alt} />
</Base>

<style>
  .sec-line { border-top: 1px solid var(--line); }
  .narrow { max-width: 960px; }
  .sub { margin: -24px 0 clamp(32px, 4vw, 48px); color: var(--muted); font-size: clamp(17px, 1.4vw, 21px); }
  .team-photo { margin: 0 0 clamp(40px, 5vw, 64px); }
  .team-photo img { width: 100%; aspect-ratio: 16 / 6; object-fit: cover; border-radius: var(--r-sm); background: var(--surface); }
  .team-photo .note { margin-top: 10px; font-size: 13px; }
  .talent { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px; }
  .talent li { border-top: 1px solid var(--ink); padding-top: 18px; font-size: 17px; }
  .more { margin-top: clamp(32px, 4vw, 48px); }
</style>
